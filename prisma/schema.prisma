// Prisma Schema for "Wawancarain"
// Platform Latihan Wawancara Kerja Berbahasa Indonesia untuk Mahasiswa & Fresh Graduate
// Compatible with PostgreSQL (Neon Serverless & Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InterviewStatus {
  ACTIVE
  FINISHED
}

enum MessageRole {
  user
  assistant
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// User model for Auth.js and credit/subscription management
model User {
  id                String             @id @default(cuid())
  email             String?            @unique
  name              String?
  password          String?
  image             String?
  emailVerified     DateTime?
  credits           Int                @default(1) // Sesi gratis awal = 1 per akun
  subscriptionUntil DateTime?

  accounts          Account[]
  sessions          Session[]
  interviewSessions InterviewSession[]
  orders            Order[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Interview Session model
model InterviewSession {
  id             String          @id @default(cuid())
  userId         String
  company        String
  position       String
  level          String          // "magang" | "fresh_graduate" | "junior"
  style          String          // "ramah" | "tegas" | "stress"
  totalQuestions Int             @default(5)
  status         InterviewStatus @default(ACTIVE)
  startedAt      DateTime        @default(now())
  endedAt        DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  evaluation     Evaluation?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId, status])
}

// Individual interview messages (conversational turns)
model Message {
  id            String           @id @default(cuid())
  sessionId     String
  role          MessageRole
  content       String           @db.Text
  questionIndex Int
  createdAt     DateTime         @default(now())

  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, questionIndex])
}

// Final comprehensive scorecard and per-answer evaluations
model Evaluation {
  id           String           @id @default(cuid())
  sessionId    String           @unique
  overallScore Int
  json         Json             // Stores full evaluation JSON (STAR analysis, per-answer feedback, radar rubric)
  createdAt    DateTime         @default(now())

  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Midtrans Snap Order model
model Order {
  id              String      @id // Unique order_id generated for Midtrans
  userId          String
  packageId       String
  amount          Int
  status          OrderStatus @default(PENDING)
  snapToken       String?     @db.Text
  midtransPayload Json?
  createdAt       DateTime    @default(now())
  paidAt          DateTime?

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}
