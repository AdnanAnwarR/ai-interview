// Prisma Schema for "Wawancarain"
// Platform Latihan Wawancara Kerja Berbahasa Indonesia untuk Mahasiswa & Fresh Graduate
// Compatible with PostgreSQL (Neon Serverless & Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for Auth.js and profile management
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Quota & subscription
  plan              String    @default("free") // "free", "pro", "unlimited"
  sessionsRemaining Int       @default(1)
  freeSessionUsed   Boolean   @default(false)
  
  accounts      Account[]
  sessions      Session[]
  interviews    Interview[]
  transactions  PaymentTransaction[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Interview session record
model Interview {
  id                String    @id @default(cuid())
  userId            String?
  candidateName     String
  targetCompany     String    // e.g. BCA, GoTo, Shopee, Telkom
  targetRole        String    // e.g. Frontend Developer, ODP
  experienceLevel   String    // "fresh_graduate", "mid_level", "senior"
  mode              String    // "hrd" or "technical"
  jobDescription    String    @db.Text
  cvContent         String?   @db.Text
  
  // Overall results
  overallScore      Int?      // 1 - 100
  passed            Boolean?  // true / false
  hiringRecommendation String? // "Strong Hire", "Hire", "Borderline", "Not Ready"
  summaryFeedback   String?   @db.Text
  scoreStructure    Int?
  scoreRelevance    Int?
  scoreCommunication Int?
  scoreDomain       Int?
  
  status            String    @default("in_progress") // "in_progress", "completed", "aborted"
  
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages          InterviewMessage[]
  answerScores      InterviewAnswerScore[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model InterviewMessage {
  id          String    @id @default(cuid())
  interviewId String
  sender      String    // "ai" or "user"
  text        String    @db.Text
  timestamp   BigInt
  durationSec Int?

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
}

// Per-answer scoring model: "di akhir mendapat nilai untuk setiap jawabannya"
model InterviewAnswerScore {
  id             String    @id @default(cuid())
  interviewId    String
  questionIndex  Int
  questionText   String    @db.Text
  answerText     String    @db.Text
  score          Int       // 0 - 100
  relevanceScore Int?
  clarityScore   Int?
  depthScore     Int?
  feedback       String    @db.Text
  strengths      String[]  // Array of strengths
  improvements   String[]  // Array of improvements
  starSituation  String?   @db.Text
  starTask       String?   @db.Text
  starAction     String?   @db.Text
  starResult     String?   @db.Text

  interview      Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
}

// Payment transaction through Midtrans Snap
model PaymentTransaction {
  id            String    @id @default(cuid())
  userId        String?
  orderId       String    @unique
  tierId        String    // "single_session", "pro_pack", "unlimited_monthly"
  amount        Int       // in IDR (e.g. 29000, 99000)
  status        String    @default("pending") // "pending", "settlement", "expire", "cancel"
  snapToken     String?   @db.Text
  paymentType   String?   // "qris", "bank_transfer", "gopay", etc
  
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
